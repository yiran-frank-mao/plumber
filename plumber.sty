% ---------------------------------------------------------------------------
% The standalone class (as in the temperleylieb package)
%
% With the `tikz' (or `multi=tikzpicture') option, standalone makes every
% top-level tikzpicture a cropped page of its own, which cannot be done from
% inside a formula.  So the formula is made the page instead (standalone's
% `math' handling turns \[...\] and \(...\) into pages), and a diagram inside
% a formula is marked as nested so that it never tries to start a page.
% ---------------------------------------------------------------------------
\cs_new_protected:Npn \__plumber_standalone_nest:
  {
    \bool_lazy_and:nnT
      { \cs_if_exist_p:N \sa@orig@tikzpicture }
      { \mode_if_math_p: }
      {
        \int_compare:nNnT \sa@internal = 0
          {
            \msg_warning:nn { plumber } { standalone-formula }
            \int_incr:N \sa@internal
          }
      }
  }
\cs_new_protected:Npn \__plumber_standalone_math:
  {
    \bool_lazy_all:nT
      {
        { \cs_if_exist_p:N \sa@orig@tikzpicture }
        { \cs_if_exist_p:N \sa@math }
        { ! \legacy_if_p:n { sa@math } }
      }
      { \sa@math }
  }
\AtBeginDocument { \__plumber_standalone_math: }

