% ---------------------------------------------------------------------------
% Variants and messages
% ---------------------------------------------------------------------------
\cs_generate_variant:Nn \prop_put:Nnn { Nee , Nen , Nne , NnV , NeV }
\cs_generate_variant:Nn \prop_item:Nn { Ne , NV }
\cs_generate_variant:Nn \prop_get:NnN { Ne }
\prg_generate_conditional_variant:Nnn \prop_get:NnN { Ne , NV } { T , F , TF }
\prg_generate_conditional_variant:Nnn \prop_if_in:Nn { Ne } { T , F , TF }
\cs_generate_variant:Nn \seq_put_right:Nn { Ne }
\cs_generate_variant:Nn \clist_put_right:Nn { Ne }
\cs_generate_variant:Nn \clist_set:Nn { Ne }
\cs_generate_variant:Nn \str_case:nn { V }
\cs_generate_variant:Nn \msg_error:nnnn { nnVe , nnne }
\cs_generate_variant:Nn \msg_error:nnnnnn { nneeee }

\regex_const:Nn \c__plumber_item_regex
  { \A \s* ([A-Za-z\'\-]+) \s* (?: \^ \s* \{? \s* ([0-9]+) \s* \}? )? \s* \Z }
\regex_const:Nn \c__plumber_arity_regex
  { \A \s* ([0-9]+) \s* [,;/] \s* ([0-9]+) \s* \Z }

\msg_new:nnn { plumber } { unknown-generator }
  {
    Unknown~generator~`#1'~in~layer~#2.~
    Known~generators:~id,~pant,~copant,~unit,~counit,~swap,~iswap,~
    pair,~copair~(aliases:~cyl,~pants,~copants,~birth,~death,~
    twist,~ev,~coev).~Write~`id^3'~for~three~copies.
  }
\msg_new:nnn { plumber } { bad-item }
  {
    Cannot~read~`#1'~in~layer~#2.~
    Write~a~generator~name,~optionally~followed~by~`^k'~(k~copies).
  }
\msg_new:nnn { plumber } { bad-arity }
  {
    The~first~argument~of~layer~#2~must~be~`m,n'~(numbers~of~input~and~
    output~circles)~or~empty,~not~`#1'.
  }
\msg_new:nnn { plumber } { arity-mismatch }
  {
    Layer~#1~is~declared~as~`#2',~but~its~generators~have~
    #3~input~and~#4~output~circles.
  }
\msg_new:nnn { plumber } { seam-mismatch }
  {
    Cannot~compose:~layer~#1~ends~with~#2~circles~but~layer~#3~starts~
    with~#4.
  }
\msg_new:nnn { plumber } { standalone-formula }
  {
    A~diagram~is~used~in~a~formula~that~the~`standalone'~class~does~not~
    turn~into~a~page:~with~its~`tikz'~option~only~TikZ~pictures,~
    \iow_char:N\\[...\iow_char:N\\]~and~\iow_char:N\\(...\iow_char:N\\)~
    become~(cropped)~pages.~Write~the~formula~with~
    \iow_char:N\\[...\iow_char:N\\]~or~\iow_char:N\\(...\iow_char:N\\),~
    or~use~\iow_char:N\\documentclass[varwidth]{standalone}~instead.
  }

% ---------------------------------------------------------------------------
% Generators
%
% Every generator has a number of input and output circles, an Euler
% characteristic, and a mirror image (the same surface read backwards).
% ---------------------------------------------------------------------------
\prop_const_from_keyval:Nn \c__plumber_in_prop
  {
    id = 1 , pant = 1 , copant = 2 , unit = 0 , counit = 1 ,
    swap = 2 , iswap = 2 , pair = 2 , copair = 0 ,
  }
\prop_const_from_keyval:Nn \c__plumber_out_prop
  {
    id = 1 , pant = 2 , copant = 1 , unit = 1 , counit = 0 ,
    swap = 2 , iswap = 2 , pair = 0 , copair = 2 ,
  }
\prop_const_from_keyval:Nn \c__plumber_chi_prop
  {
    id = 0 , pant = -1 , copant = -1 , unit = 1 , counit = 1 ,
    swap = 0 , iswap = 0 , pair = 0 , copair = 0 ,
  }
\prop_const_from_keyval:Nn \c__plumber_mirror_prop
  {
    id = id , pant = copant , copant = pant , unit = counit ,
    counit = unit , swap = swap , iswap = iswap , pair = copair ,
    copair = pair ,
  }
\prop_const_from_keyval:Nn \c__plumber_alias_prop
  {
    id = id , pant = pant , copant = copant , unit = unit ,
    counit = counit , swap = swap , iswap = iswap , pair = pair ,
    copair = copair ,
    cyl = id , cylinder = id , pants = pant , copants = copant ,
    birth = unit , death = counit , twist = swap , itwist = iswap ,
    ev = pair , coev = copair ,
  }

